# Database (Vercel Marketplace Neon integration)
DATABASE_URL=

# Protects Vercel Cron requests. Use a long random value.
CRON_SECRET=

# Protects the one-off manual monitor API.
MONITOR_ADMIN_TOKEN=

# Telegram target. Do not expose either value to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VMMS
VMMS_BASE_URL=https://vmms.ubcn.co.kr
VMMS_LOGIN_ID=
VMMS_LOGIN_PASSWORD=
VMMS_COMPANY=806
VMMS_ORGAN=207368
# The source field for the bulk-purchase discriminator. Default is input_type.
VMMS_BULK_FIELD=input_type
VMMS_BULK_VALUE=99

# EasyShop
EASYSHOP_BASE_URL=https://smarteasyshop.kicc.co.kr
EASYSHOP_LOGIN_ID=
EASYSHOP_LOGIN_PASSWORD=
# Optional fallbacks when the login response does not supply these values.
EASYSHOP_MEMBER_ID=
EASYSHOP_AUT_ID=
EASYSHOP_BIZR_NO=*
EASYSHOP_TID=*

